# Database
DATABASE_URL=sqlite:///./sports_passport.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CollegeFootballData.com API
CFB_API_KEY=your-api-key-here
CFB_API_URL=https://api.collegefootballdata.com

# Application
APP_NAME="SportsPassport2"
DEBUG=True

# CORS — comma-separated allowed origins. The SPA is served by this same app,
# so production needs no entries beyond the dev server; never use "*" (with
# credentials enabled it lets any site call the API).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting on login and password-reset endpoints
RATE_LIMIT_ENABLED=True

# Password reset email (Mailtrap) — leave blank locally to skip sending
MAILTRAP_API_KEY=
APP_BASE_URL=http://localhost:5173
FROM_EMAIL=noreply@bronnerapp.com
FROM_NAME="Sports Passport"

# Sentry error monitoring — leave blank locally to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
