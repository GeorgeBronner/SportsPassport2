# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

#IDE
.idea/

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Env / secrets
.env

# Bulk historical data files (downloaded, not committed)
backend/data/raw/

# Team logos (scraped from ESPN, not committed)
backend/data/logos/

# Nominatim response cache written by scripts/geocode_venues.py
backend/data/geocode_cache.json

# Frontend
node_modules/
frontend/dist/
backend/static/*
!backend/static/.gitkeep

# Runtime data volume (repo-root only). Venue seed CSVs are committed under
# backend/sports_passport/data/seed/ — inside the package, never in this volume.
/data/

# OS
.DS_Store
Thumbs.db

# Playwright CLI session artifacts
.playwright-cli/

# Claude Code — skills and shared settings are committed; personal ones are not.
# Machine-local runtime state (locks, worktrees, checkpoints) is handled
# separately in .git/info/exclude.
.claude/settings.local.json
